# ──────────────────────────────────────────────────────────────────────────────
# DoseLoop 2.0 — Environment Variables Reference
#
# Copy this file to .env (never commit .env to git).
# For local dev, copy to server/.env and client/.env.
# For Vercel production, set these in Vercel Project Settings > Environment Variables.
# ──────────────────────────────────────────────────────────────────────────────

# ─── Application ───────────────────────────────────────────────────────────────

# 📋 Runtime environment
NODE_ENV=development
PORT=5000

# ─── Database (Prisma + Supabase PostgreSQL) ──────────────────────────────────

# 🔒 Pooled connection string for Cloud Run (use Supabase Transaction Pooler, port 6543)
# Format: postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require&connection_limit=5
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require&connection_limit=5

# 🔒 Direct (non-pooled) connection for migrations only
# Format: postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
DIRECT_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# ─── Supabase ──────────────────────────────────────────────────────────────────

# 📋 Your Supabase project URL (safe to expose — not a secret)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# 🔒 Service role key — SERVER-SIDE ONLY. Never expose to the browser/client.
# Found in: Supabase Dashboard → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Authentication ────────────────────────────────────────────────────────────

# 🔒 A cryptographically strong random secret (min 32 chars).
# Generate one with: openssl rand -hex 32
# NOTE: Rotating this invalidates all existing custom JWTs if any are used.
# (Supabase tokens use their own secret, not this one.)
JWT_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32_OUTPUT

# 📋 Comma-separated list of allowed CORS origins in production.
# Set to the exact Cloud Run URL of the client (no trailing slash).
# Example: https://doseloop-client-XXXX-uc.a.run.app
CORS_ORIGIN=https://doseloop-client-XXXX-uc.a.run.app

# ─── AI (Groq) ─────────────────────────────────────────────────────────────────

# 🔒 Groq API key — get one at https://console.groq.com/keys
# If absent, the AI assistant returns a graceful fallback (server still boots).
GROQ_API_KEY=gsk_your_real_groq_key_here

# ─── Email (Resend) ────────────────────────────────────────────────────────────

# 🔒 Resend API key — get one at https://resend.com/api-keys
RESEND_API_KEY=re_your_real_resend_key_here

# 📋 Sender address for all DoseLoop emails.
# Must match a verified domain in your Resend account.
RESEND_FROM_EMAIL=emergency@doseloop.com

# ─── Cron Security ─────────────────────────────────────────────────────────────

# 🔒 Bearer token to authenticate Cloud Scheduler → /api/v1/cron/reminders
# Generate with: openssl rand -hex 32
CRON_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32_OUTPUT

# ─── Frontend (Vite build-time — baked into the static bundle) ────────────────
# These are set as Docker build ARGs in client/Dockerfile and in cloudbuild.yaml.
# They are NOT server-side values — do NOT put server secrets in VITE_ vars.

# 📋 Public Supabase URL (same as SUPABASE_URL above but for client bundle)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# 📋 Supabase anon key — safe to expose to the browser (has restrictive RLS)
# Found in: Supabase Dashboard → Settings → API → anon/public key
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 📋 Backend API URL baked into the client bundle at build time
# Set to the Cloud Run URL of doseloop-server in production.
VITE_API_URL=http://localhost:5000/api/v1
