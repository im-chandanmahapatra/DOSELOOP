# DoseLoop 2.0 — Server Environment Variables

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development
PORT=5000

# PostgreSQL Database Connection
# For local PostgreSQL: postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/doseloop?sslmode=disable
# For Supabase/Cloud PostgreSQL: postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require&connection_limit=5
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/doseloop?sslmode=disable

# Direct PostgreSQL URL (Used for Prisma migrations/schema pushes)
DIRECT_URL=postgresql://postgres:password@127.0.0.1:5432/doseloop?sslmode=disable

# Authentication & Security
# Generate a secure 32+ character secret for JWT tokens
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
CORS_ORIGIN=http://localhost:5173

# Optional: Supabase Auth Integration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Groq AI Assistant (Pulse AI)
# Get your API key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Email Delivery (Resend - Optional)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=emergency@doseloop.com

# Serverless Cron Secret (For Vercel cron background reminder execution)
CRON_SECRET=your_random_secure_cron_token_here
