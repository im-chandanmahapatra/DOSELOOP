{
  "name": "doseloop",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm run prisma:generate && npm run build:server && npm run build:client",
    "vercel-build": "npm run prisma:generate && npm run build:server && npm run build:client",
    "build:server": "npm --prefix server run build",
    "prisma:generate": "npm --prefix server run prisma:generate",
    "build:client": "npm --prefix client run build",
    "lint": "concurrently \"npm --prefix server run lint\" \"npm --prefix client run lint\"",
    "type-check": "concurrently \"npm --prefix server run type-check\" \"npm --prefix client run type-check\"",
    "test": "npm --prefix server run test",
    "test:speech": "npm --prefix server run test:speech",
    "test:emergency": "npm --prefix server run test:emergency",
    "test:client": "npm --prefix server run test:client",
    "db:start": "powershell -Command \"& 'C:\\Program Files\\PostgreSQL\\18\\bin\\postgres.exe' -D 'C:\\Users\\HP\\.doseloop_db' -p 5433\"",
    "db:push": "npm --prefix server run db:push",
    "db:seed": "npm --prefix server run db:seed",
    "db:studio": "npm --prefix server run db:studio"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "typescript": "^6.0.3"
  }
}
